# 로컬 모드는 IndexedDB, cloud 모드는 Neon 원본 + IndexedDB 캐시를 사용합니다.
VITE_APP_MODE=local
VITE_INTEGRATIONS=off

# YouTube Data API v3 키 (서버 전용 — VITE_ 접두사 금지)
YOUTUBE_API_KEY=

# OpenAI Responses API (서버 전용 — VITE_ 접두사 금지)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Neon PostgreSQL (서버 전용)
DATABASE_URL=

# Firebase Google 로그인 (웹 클라이언트 공개 설정)
VITE_AUTH_PROVIDER=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin — Vercel Functions에서 ID 토큰 검증
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 클라우드 모드로 강제 로그인할 때
# VITE_APP_MODE=cloud

# 로컬 개발에서만 무인 API 호출 허용. 운영에서는 사용하지 않습니다.
# ALLOW_DEV_AUTH=true
